# ==============================================================================
# MEDGÓN PASSIVHAUS - CONFIGURACIÓN APACHE PARA SUBDIRECTORIO /app/
# ==============================================================================
# Esta regla aísla la aplicación estática de las reglas de reescritura de WordPress

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /app/

  # Si el archivo o carpeta solicitado existe físicamente, servirlo directamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Soporte para URLs limpias (ej. /app/blog -> /app/blog.html)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]
</IfModule>

# Tipos MIME estándar y caché estática
<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType application/xml .xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/xml image/svg+xml
</IfModule>

# Prevención de indexación de directorios
Options -Indexes
